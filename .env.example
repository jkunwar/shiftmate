# Copy to .env and fill in. Both values are in Supabase → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: crash reporting with Sentry. Reports are sent only from release builds, and only when
# this is set. Sentry project → Settings → Client Keys (DSN); it is safe to ship inside the app.
EXPO_PUBLIC_SENTRY_DSN=
